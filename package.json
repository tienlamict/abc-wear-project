{
  "name": "abc-wear",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker,mock -c blue,green,magenta \"pnpm:dev:web\" \"pnpm:dev:worker\" \"pnpm:dev:mock\"",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:mock": "tsx watch mock-main/server.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "start:cluster": "node scripts/web-cluster.mjs",
    "start:all": "concurrently -k -n web,worker,mock -c blue,green,magenta \"pnpm:start:cluster\" \"tsx worker/index.ts\" \"tsx mock-main/server.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "docker run --rm -i -e BASE_URL=http://host.docker.internal:3000 grafana/k6:1.0.0 run - < tests/load/k6.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "mock:seed": "tsx mock-main/generate-seed.ts",
    "seed:images": "tsx mock-main/seed-images.ts",
    "sync": "tsx worker/sync.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/basic-auth": "6.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "5",
    "jose": "^6.2.12",
    "minio": "8.0.7",
    "next": "14",
    "nodemailer": "^10.1.1",
    "react": "18",
    "react-dom": "18",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "18",
    "@types/react-dom": "18",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "8",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "3",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.0.4"
  }
}
