{
  "name": "abc-wear",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker,mock -c blue,green,magenta \"pnpm:dev:web\" \"pnpm:dev:worker\" \"pnpm:dev:mock\"",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:mock": "tsx watch mock-main/server.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fastify": "5",
    "next": "14",
    "react": "18",
    "react-dom": "18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "8",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "3",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.0.4"
  }
}
